#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <6 7>;
        };

        simgle_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <18 19>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <30 31>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W         &kp E         &kp R      &kp T                                                &kp Y      &kp U  &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S         &kp D         &kp F      &kp G        &kp LS(LG(S))         &kp BACKSPACE     &kp H      &kp J  &kt K      &kp L    &mt RCTRL SEMICOLON
&mt LEFT_SHIFT Z    &kp X         &kp C         &kp V      &kp B        &kp ESCAPE            &kp DELETE        &kp N      &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp ASTERISK        &kp LEFT_WIN  &kp LEFT_ALT  &lt 4 TAB  &lt 1 SPACE  &lt 5 LANGUAGE_2      &lt 6 LANGUAGE_1  &kp ENTER                             &kp BACKSLASH
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0                             &kp KP_DIVIDE    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS
&trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans        &trans      &kp KP_EQUAL   &kp KP_MULTIPLY  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans        &trans      &trans         &kp KP_NUMBER_0  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DOT
&trans  &trans        &trans        &trans        &trans        &trans      &kp BACKSPACE  &kp KP_ENTER                                                        &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp F10  &kp F1  &kp F2  &kp F3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F12  &kp F7  &kp F8  &kp F9  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                           &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans          &kp UP_ARROW    &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &kp PAGE_UP     &kp PAGE_DOWN   &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        JAVA_R {
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &kp ASTERISK   &kp LPAR       &kp RPAR          &kp MINUS         &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans      &kp AMPERSAND  &kp SEMICOLON  &kp LBRC       &kp RBRC          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &kp COLON      &kp LESS_THAN  &kp GREATER_THAN  &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &trans                                                            &trans
            >;
        };

        JAVA_L {
            bindings = <
&trans           &trans       &trans    &trans      &kp CARET                        &trans  &trans  &trans  &trans  &trans
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans           &trans       &trans    &trans      &trans       &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans           &trans       &trans    &trans      &trans       &trans      &trans  &trans                          &trans
            >;
        };
    };
};
